# Env for local dev only: `pnpm seed` applies it to Convex, compose.yaml
# and the CI image job to the container.
SITE_URL=http://localhost:3000
# Lets other devices on the LAN log in too.
TRUSTED_ORIGINS=http://192.168.*:3000,http://10.*:3000
BETTER_AUTH_SECRET=dev-only-secret-never-use-in-production
ADMIN_EMAIL=admin@chatslop.invalid
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hogehoge
# Streams canned Answers instead of calling a Provider. Remove it, and set
# each Provider's base URL and API key in /admin, to talk to real Models.
MOCK_MODEL=1
