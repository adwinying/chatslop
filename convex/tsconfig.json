{
  /* Typechecks the Convex functions. Required settings per Convex docs. */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "types": ["vite/client", "node"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated", "./betterAuth/_generated"]
}
