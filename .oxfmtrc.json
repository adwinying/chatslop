{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "sortImports": {
    "groups": [
      "type",
      "builtin",
      "external",
      "internal",
      "parent",
      "sibling",
      "index",
      "unknown"
    ],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/_generated/**",
    "convex/betterAuth/generatedSchema.ts",
    "src/routeTree.gen.ts",
    ".agents/**",
    ".claude/**",
    "skills-lock.json"
  ]
}
